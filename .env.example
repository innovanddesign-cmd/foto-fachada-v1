# Configure only in your local or preview environment. Never commit real secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Same Supabase project as the public URL above. Server only.
DATABASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=
# Enable only after migration, account import, tariff approval and preview validation.
INNOVA_CREDITS_ENABLED=false

# Official Supabase CA PEM; server only, needed for verified database TLS.
SUPABASE_DB_CA=

# Only enable after verifying FREE billing and output quality. No paid fallback.
INNOVA_FREE_AI_ENABLED=false
INNOVA_FREE_TEXT_PROVIDER=openrouter
OPENROUTER_FREE_API_KEY=
OPENROUTER_FREE_MODEL=apodex/apodex-1.1-mini:free
GROQ_FREE_API_KEY=
GROQ_FREE_MODEL=
CLOUDFLARE_FREE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Paddle Billing — Sandbox only; never use live keys here.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_ANNUAL=
PADDLE_PRICE_BUSINESS_MONTHLY=
PADDLE_PRICE_BUSINESS_ANNUAL=
PADDLE_PRICE_CREDITS_SMALL=
PADDLE_PRICE_CREDITS_MEDIUM=
PADDLE_PRICE_CREDITS_LARGE=
