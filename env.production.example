# ==========================================
# Foto Fachada - Production Environment
# ==========================================

# Server Configuration
PORT=3000
NODE_ENV=production
FRONTEND_ORIGIN=https://app.fotofachada.com

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Authentication (Supabase / JWT)
JWT_SECRET=your-super-secure-jwt-secret-key-at-least-32-chars
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Services (Google Gemini)
GEMINI_API_KEY=your-google-gemini-api-key

# Payments (Stripe)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_BASE=price_...
STRIPE_PRICE_ID_PLUS=price_...
STRIPE_PRICE_ID_PRO=price_...

# Infrastructure (Cloudflare / Domains)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
DOMAIN_ZONE_ID=your-zone-id
