# Add to the actual Next.js environment, not the legacy Express configuration.
# Keep disabled until migrations, storage credentials and background executor are validated.
INNOVA_MAINTENANCE_ENABLED=false
INNOVA_SCHEDULING_ENABLED=false
INNOVA_CONTACTS_ENABLED=false
# Server only. Never prefix this key with NEXT_PUBLIC_. Supply through the secret manager.
SUPABASE_SERVICE_ROLE_KEY=
INNOVA_EMAIL_ENABLED=false
INNOVA_EMAIL_DOMAIN_VERIFIED=false
INNOVA_EMAIL_FROM=
INNOVA_PUBLIC_ORIGIN=
RESEND_API_KEY=
# Separate random secret (at least 32 characters); server/scheduler only.
INNOVA_WORKER_SECRET=
